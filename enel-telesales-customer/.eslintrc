{
  "extends": "fbjs",
  "rules": {
    "template-curly-spacing": "off",
    "indent": "off",
    "linebreak-style": "off",
    "quotes": [
      "error",
      "single"
    ],
    "semi": [
      "error",
      "always"
    ],
    "jsx-a11y/no-static-element-interactions": 0,
    "consistent-return": 0,
    "curly": 0,
    "radix": 0,
    "max-len": 0
  }
}
