{
    "private": true,
    "name": "ppc-fast-contracting-web",
    "version": "0.0.1",
    "description": "PPC Fast Contracting",
    "main": "bin/server.js",
    "engines": {
        "node": ">=8.9.1",
        "npm": "^5.4.2"
    },
    "babel": {
        "presets": [
            "es2015",
            "react"
        ]
    },
    "scripts": {
        "clean": "rimraf dist coverage",
        "compile": "better-npm-run compile",
        "lint": "eslint bin build config server src tests",
        "lint:fix": "npm run lint -- --fix",
        "start": "better-npm-run start",
        "dev": "better-npm-run dev",
        "test": "better-npm-run test",
        "test:dev": "npm run test -- --watch",
        "deploy": "better-npm-run deploy",
        "deploy:dev": "better-npm-run deploy:dev",
        "deploy:prod": "better-npm-run deploy:prod",
        "codecov": "cat coverage/*/lcov.info | codecov"
    },
    "betterScripts": {
        "compile": {
            "command": "node --openssl-legacy-provider bin/compile",
            "env": {
                "DEBUG": "app:*"
            }
        },
        "dev": {
            "command": "nodemon --openssl-legacy-provider bin/server --ignore dist --ignore coverage --ignore tests --ignore src",
            "env": {
                "NODE_ENV": "development",
                "DEBUG": "app:*"
            }
        },
        "deploy": {
            "command": "npm run lint && npm run test && npm run clean && npm run compile",
            "env": {
                "DEBUG": "app:*"
            }
        },
        "deploy:dev": {
            "command": "npm run deploy",
            "env": {
                "NODE_ENV": "development",
                "DEBUG": "app:*"
            }
        },
        "deploy:prod": {
            "command": "npm run deploy",
            "env": {
                "NODE_ENV": "production",
                "DEBUG": "app:*"
            }
        },
        "start": {
            "command": "node --openssl-legacy-provider bin/server --inspect=0.0.0.0:5238",
            "env": {
                "DEBUG": "app:*"
            }
        },
        "test": {
            "command": "node ./node_modules/karma/bin/karma start config/karma.conf",
            "env": {
                "NODE_ENV": "test",
                "DEBUG": "app:*"
            }
        }
    },
