  "scripts": {
    "remove-node-modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "test": "npm run eslint && npm run mocha",
    "eslint": "eslint src/. test/. --config .eslintrc.json",
    "start": "node -r dotenv/config src/",
    "mocha": "mocha test/ --recursive --exit",
    "local": "nodemon --inspect -r dotenv/config src/",
    "cms-build": "parcel build -d ./public/v2 ./public/cms-v2/app/index.jsx",
    "cms-watch": "parcel watch -d ./public/ ./public/cms/app/index.jsx",
    "local-cms": "npm run local | npm run cms-watch",
    "cms-v2-build": "parcel build -d ./public/v2 ./public/cms-v2/app/index.jsx",
    "cms-v2-watch": "parcel watch -d ./public/v2 ./public/cms-v2/app/index.jsx",
    "local-cms-v2": "npm run local | npm run cms-v2-watch",
    "break": "nodemon --inspect-brk -r dotenv/config src/",
    "setup-offline": "npm run remove-node-modules && npm run remove-lockfile && npm install"
  },
