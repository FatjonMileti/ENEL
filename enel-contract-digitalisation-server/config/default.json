{
    "host": "localhost",
    "protocol": "http",
    "port": "PORT",
    "public": "../public/",
    "paginate": {
        "default": 100,
        "max": 10000000
    },
    "postgres": "PG_CONNECTION_STRING",
    "sqlLogging": false,
    "schema": "PG_SCHEMA",
    "authentication": {
        "service": "users",
        "secret": "",
        "strategies": [
            "local",
            "client"
        ],
        "path": "/authentication",
        "local": {
            "name": "local",
            "usernameField": "marca",
            "passwordField": "password",
            "service": "users",
            "entity": "users"
        },
        "client": {
            "name": "devices",
            "usernameField": "clientid",
            "passwordField": "clientsecret",
            "service": "devices",
            "entity": "devices"
        },
        "jwt": {
            "header": {
                "typ": "access"
            },
            "audience": "https://www.ppcenergy.ro",
            "subject": "anonymous",
            "issuer": "feathers",
            "algorithm": "HS256",
            "expiresIn": "1d"
        }
    },
    "mailing": {
        "smtp": "SMTP_SERVER",
        "from": "MAIL_FROM",
        "offer": "MAIL_FROM_OFFER"
    },
    "smsFolderPath": "SMS_PATH",
    "absoluteUrl": "ABSOLUTE_URL",
    "absoluteClientUrl": "ABSOLUTE_CLIENT_URL",
    "offerExpiresInDays": 90,
    "passRules": {
        "minimumLength": 8,
        "minimumScore": 5,
        "initialDaysToChange": 3,
        "expiryDays": 90,
        "maxDaysInactivityPeriod": 180,
        "latestPasswords": 4,
        "maxOfAttempts": 10,
        "inactivityMinutes": 5
    }
}
